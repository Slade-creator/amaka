# Backend origin used by `vite build --mode mobile` (the Android app).
# Copy this file to `.env.mobile.local` and set the real origin. No trailing slash.
#
#   LAN demo:  http://<laptop-lan-ip>:8000   (phone and laptop on the same Wi-Fi)
#   Cloud:     https://<api-id>.execute-api.<region>.amazonaws.com
#
# Leave it empty to build same-origin (only useful when the same server hosts
# the UI, which is not the case inside the Capacitor WebView).
VITE_API_BASE_URL=
